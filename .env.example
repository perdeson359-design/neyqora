PORT=8787
HOST=0.0.0.0
OWNER_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters
USER_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=onboarding@resend.dev

# OpenAI-compatible chat-completions endpoint.
NEYQORA_AI_BASE_URL=https://your-ai-provider.example/v1
NEYQORA_AI_API_KEY=replace-with-provider-key
NEYQORA_AI_MODEL=your-model-name

# Use a persistent volume for this directory in container deployments.
NEYQORA_DB_PATH=./data/neyqora.db
NEYQORA_SELF_HOSTED=1
AI_PROVIDER_MODE=auto
# LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_AI_API_KEY=
# LOCAL_AI_MODEL=your-local-model
