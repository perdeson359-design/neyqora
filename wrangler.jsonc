{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neyqora",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neyqora-memory",
      "database_id": "1fd23168-d954-4989-b90b-c3bd00ec0ea9"
    }
  ],
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "1fd23168-d954-4989-b90b-c3bd00ec0ea9"
      }
    ]
  }
}